## relkit template: si.env for `si -batch -command netlist` (CDL netlist for LVS).
## Ported from Auto_ext (github.com/weisbert/Auto_ext, commit fd32c80)
## templates/si/default.env.j2: Jinja2 -> string.Template. Lines starting with
## "##" are template comments and are dropped by rk_extract.render_template().
## Every ${name} is filled by rk_extract.si_env_values(); booleans arrive
## already formatted as SKILL literals ('t / 'nil), lists as '("a" "b").
## Kept verbatim from the source: simReNetlistAll writes a bare nil when false.
simLibName = "${library}"
simCellName = "${cell}"
simViewName = "${source_view}"
simSimulator = "${sim_simulator}"
simNotIncremental = ${sim_not_incremental}
simReNetlistAll = ${sim_renetlist_all}
simViewList = ${sim_view_list}
simStopList = ${sim_stop_list}
hnlNetlistFileName = "${netlist_file_name}"
simRunDir = "${output_dir}"
resistorModel = ""
shortRES = ${short_res}
preserveRES = ${preserve_res}
checkRESVAL = ${check_res_val}
checkRESSIZE = ${check_res_size}
preserveCAP = ${preserve_cap}
checkCAPVAL = ${check_cap_val}
checkCAPAREA = ${check_cap_area}
preserveDIO = ${preserve_dio}
checkDIOAREA = ${check_dio_area}
checkDIOPERI = ${check_dio_peri}
checkCAPPERI = ${check_cap_peri}
simPrintInhConnAttributes = ${sim_print_inh_conn_attributes}
checkScale = "${check_scale}"
checkLDD = ${check_ldd}
pinMAP = 'nil
preserveBangInNetlist = ${preserve_bang_in_netlist}
shrinkFACTOR = ${shrink_factor}
globalPowerSig = "${global_power_sig}"
globalGndSig = "${global_gnd_sig}"
displayPININFO = ${display_pin_info}
preserveALL = ${preserve_all}
setEQUIV = ""
incFILE = "${inc_file}"
auCdlDefNetlistProc = "ansCdlSubcktCall"
